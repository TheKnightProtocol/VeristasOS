# VeristasOS Environment Configuration Template
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=*

# Optional Subsystems Configuration
DEEPFAKE_ENABLED=false
SEMANTIC_SEARCH_ENABLED=true

# AI Provider Configuration (Options: auto, cloud, ollama, llamacpp, local)
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Optional Local AI Integration
OLLAMA_HOST=http://127.0.0.1:11434
LLAMA_CPP_HOST=http://127.0.0.1:8080
VERISTAS_AI_URL=http://127.0.0.1:8080
VERISTAS_AI_TIMEOUT=5
