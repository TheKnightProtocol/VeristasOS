# ============================================================
# VERISTASOS ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Local AI Server URL (llama.cpp or OpenAI-compatible backend)
VERISTAS_AI_URL=http://127.0.0.1:8080

# Local AI Request Timeout (in seconds)
VERISTAS_AI_TIMEOUT=5

# Environment Mode: development | production
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated, e.g. https://yourdomain.com,http://localhost:8000)
ALLOWED_ORIGINS=*

# Optional Port Override for Uvicorn
PORT=8000
